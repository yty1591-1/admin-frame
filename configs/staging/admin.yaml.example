# A 端（admin-api）预发环境配置示例（CONFIG_STANDARDS CFG-01/07）。
# 公共段引用 ../prod/modules 基线，staging 差异集中在 modules/staging.yaml.example；
# 本文件只声明 A 端差异（service/channel/addr/audience/node_id/CORS）。
# 使用方式：cp configs/staging/admin.yaml.example configs/staging/admin.yaml
# 变量清单见 configs/staging/env.example；权威基线为 values-staging.yaml。

include:
  - ../prod/modules/http.yaml.example
  - ../prod/modules/log.yaml.example
  - ../prod/modules/platform.yaml.example
  - ../prod/modules/auth.yaml.example
  - ../prod/modules/infra.yaml.example
  - ../prod/modules/iam.yaml.example
  - ../prod/modules/identity.yaml.example
  - ../prod/modules/notification.yaml.example
  - modules/staging.yaml.example

env: staging
service: admin-api
channel: admin
addr: ":8081"
shutdown_timeout: 20s

auth:
  expected_channel: admin # 必须与 channel 完全一致，防止跨端令牌串用
  jwt:
    audience: [admin]

# 预发显式声明 node_id（ADMIN_FRAME_ID_NODE_ID）；部署在 StatefulSet 中可改为
# node_id_source: statefulset，由 HOSTNAME 序号推导，二者取其一。
id:
  node_id_source: env
  # node_id: 0

# 预发与生产同构：开启身份域；前置 hash_key / mfa.secret_key 由 Secret 注入。
identity:
  enabled: true

storage:
  key_prefix: "staging/admin/"

# 预发必须显式 Origin，禁止 "*"；与 allow_credentials 互斥。
cors:
  allow_origins:
    - https://admin.staging.example.com
  allow_headers: [Accept, Authorization, Content-Type, X-Request-ID, Idempotency-Key]
  expose_headers: [X-Request-ID]
  allow_credentials: true
  max_age: 10m
