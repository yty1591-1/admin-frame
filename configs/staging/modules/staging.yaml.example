# staging 环境覆盖：只声明与 prod 模块基线的差异键（CONFIG_STANDARDS CFG-07）。
# 公共段仍引用 ../prod/modules/*，避免多套样板的 schema 漂移；
# 本文件在 include 列表末尾加载，优先级高于 prod 模块，低于各端服务文件。
#
# staging 口径：拓扑近似生产、真实依赖、密钥隔离；沿用 prod/staging 的强制校验
# （id.node_id 必填、幂等/限流必须 redis）。取值对齐 deploy/helm/admin-frame/values-staging.yaml。

auth:
  mode: jwt # prod/staging 唯一合法值
  jwt:
    alg: RS256 # 预发使用密钥环；HS256 仅本地
    issuer: admin-frame
    secret: "" # RS256 与 HS256 互斥
    public_key_file: "/etc/admin-frame/jwt/public.pem" # 由 K8s Secret 挂载
    active_kid: "" # 需要轮换时改用 keys + active_kid

redis:
  key_prefix: "admin-frame/staging/" # 与 prod 共用实例时隔离键空间

storage:
  driver: s3 # staging 必须对象存储
  key_prefix: "staging/"
  s3:
    endpoint: https://minio.storage.svc.cluster.local:9000 # 预发 MinIO 网关
    region: us-east-1
    bucket: admin-frame-staging
    force_path_style: true # MinIO / S3 兼容网关
    disable_ssl: false

tracing:
  enabled: true
  exporter: otlp
  endpoint: otel-collector.observability.svc.cluster.local:4318
  sample_ratio: 1.0 # 预发全采样，尾部采样交给 Collector
  insecure: true # 集群内网明文

async:
  enabled: true
  driver: db
  outbox:
    publish_in_api: false # 由 worker 独占投递，避免重复

iam:
  mode: shadow # 预发先影子观察；确认无违规后切 enforce
  cache:
    driver: redis # enforce 在 staging 强制 redis；shadow 也保持一致

secrets:
  providers: [env] # 预发密钥隔离，仍走 K8s Secret → 环境变量
  allow_env_fallback: true
  file:
    dir: "" # 切换到文件托管源时填 /var/run/secrets/admin-frame-staging
