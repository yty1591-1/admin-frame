# 预发环境环境变量示例（对应 configs/staging/*.yaml.example）。
#
#    安全声明：以下值仅为占位符，绝不代表预发真实值；预发真实密钥由
#    K8s Secret / 密钥托管注入（CFG-06）。禁止把真实 DSN / 密钥提交到仓库。
#
#    staging 不复用 prod 的任何密钥、DSN、bucket；变量名与环境示例保持一一对应。
#
# 使用方式：由部署流水线把 Secret 注入为环境变量；本地验证时按同名列导出。

# ---- 运行环境 ---------------------------------------------------------------
ADMIN_FRAME_ENV=staging

# ---- MySQL ---------------------------------------------------------------
ADMIN_FRAME_DB_DRIVER=mysql
ADMIN_FRAME_DB_DSN=REPLACE_WITH_STAGING_DB_DSN

# ---- Redis ---------------------------------------------------------------
ADMIN_FRAME_REDIS_ADDR=redis-master.data.svc.cluster.local:6379
ADMIN_FRAME_REDIS_PASSWORD=REPLACE_WITH_STAGING_REDIS_PASSWORD

# ---- JWT（RS256 公钥由 Secret 挂载；私钥仅在签发侧）--------------------------
ADMIN_FRAME_AUTH_JWT_PUBLIC_KEY_FILE=/etc/admin-frame/jwt/public.pem

# ---- 对象存储（MinIO / S3 兼容网关）------------------------------------------
ADMIN_FRAME_STORAGE_S3_ACCESS_KEY_ID=REPLACE_WITH_STAGING_STORAGE_KEY_ID
ADMIN_FRAME_STORAGE_S3_SECRET_ACCESS_KEY=REPLACE_WITH_STAGING_STORAGE_SECRET

# ---- 通知运行时（c-api / worker 启动期 fail-closed 校验项）------------------
ADMIN_FRAME_NOTIFICATION_CALLBACK_SECRET=REPLACE_WITH_STAGING_CALLBACK_SECRET
ADMIN_FRAME_NOTIFICATION_BLACKLIST_SALT=REPLACE_WITH_STAGING_BLACKLIST_SALT

# ---- 身份域（identity.enabled=true 时才需要）--------------------------------
# ADMIN_FRAME_IDENTITY_HASH_KEY=REPLACE_WITH_STAGING_HASH_KEY
# ADMIN_FRAME_IDENTITY_SUBJECT_KEYS=REPLACE_WITH_STAGING_SUBJECT_KEYS
# ADMIN_FRAME_IDENTITY_MFA_KEYS=REPLACE_WITH_STAGING_MFA_KEYS
# ALIYUN_SMS_ACCESS_KEY_ID=REPLACE_WITH_STAGING_SMS_KEY_ID
# ALIYUN_SMS_ACCESS_KEY_SECRET=REPLACE_WITH_STAGING_SMS_SECRET
