# B 端（biz-api）预发环境配置示例（CONFIG_STANDARDS CFG-01/07）。
# 公共段引用 ../prod/modules 基线，staging 差异集中在 modules/staging.yaml.example；
# 本文件只声明 B 端差异（channel/audience/node_id/限流分桶/CORS）。
# 使用方式：cp configs/staging/biz.yaml.example configs/staging/biz.yaml

include:
  - ../prod/modules/http.yaml.example
  - ../prod/modules/log.yaml.example
  - ../prod/modules/platform.yaml.example
  - ../prod/modules/auth.yaml.example
  - ../prod/modules/infra.yaml.example
  - ../prod/modules/iam.yaml.example
  - ../prod/modules/identity.yaml.example
  - ../prod/modules/notification.yaml.example
  - modules/staging.yaml.example

env: staging
service: biz-api
channel: biz
addr: ":8082"
shutdown_timeout: 20s

auth:
  expected_channel: biz # 必须与 channel 一致；B 端令牌不得被 A/C 端接受
  jwt:
    audience: [biz]

id:
  node_id_source: env # StatefulSet 部署可改为 statefulset，由 HOSTNAME 序号推导

rate_limit:
  key: channel_tenant_user # B 端按 商户+用户 分桶，避免跨商户争抢配额

identity:
  enabled: true
  mfa:
    admin_required: false
  mfa:
    admin_required: false

storage:
  key_prefix: "staging/biz/"

cors:
  allow_origins:
    - https://biz.staging.example.com
  allow_headers: [Accept, Authorization, Content-Type, X-Request-ID, Idempotency-Key]
  expose_headers: [X-Request-ID]
  allow_credentials: true
  max_age: 10m
