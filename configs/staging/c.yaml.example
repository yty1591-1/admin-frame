# C 端（c-api）预发环境配置示例（CONFIG_STANDARDS CFG-01/07）。
# 公共段引用 ../prod/modules 基线，staging 差异集中在 modules/staging.yaml.example；
# 本文件只声明 C 端差异（channel/audience/node_id/上传上限/IAM 关闭）。
# 使用方式：cp configs/staging/c.yaml.example configs/staging/c.yaml
# 身份域默认关闭；联调短信 / OAuth 时按 modules/identity 的注释启用，
# staging 禁止 memory 驱动与明文 client_secret。

include:
  - ../prod/modules/http.yaml.example
  - ../prod/modules/log.yaml.example
  - ../prod/modules/platform.yaml.example
  - ../prod/modules/auth.yaml.example
  - ../prod/modules/infra.yaml.example
  - ../prod/modules/iam.yaml.example
  - ../prod/modules/identity.yaml.example
  - ../prod/modules/notification.yaml.example
  - modules/staging.yaml.example

env: staging
service: c-api
channel: c
addr: ":8083"
shutdown_timeout: 20s

auth:
  expected_channel: c # 必须与 channel 一致，防止 A/B 令牌串用
  jwt:
    audience: [c]

id:
  node_id_source: env # StatefulSet 部署可改为 statefulset，由 HOSTNAME 序号推导

http:
  body_limit_bytes: 33554432 # C 端上传场景较多，设为 32 MiB

async:
  consumer:
    concurrency: 8 # C 端通知/异步任务量更大

# C 端不挂载 IAM：mode 必须 off（启动校验会拒绝其他取值）。
iam:
  mode: off
  cache:
    driver: memory
  approval:
    enabled: false
  constraints:
    mode: off

identity:
  enabled: false
  mfa:
    admin_required: false
  sms:
    enabled: false
    driver: aliyun # staging 禁止 memory；启用时凭证走 ALIYUN_SMS_*_KEY
    template_id: ""
    sign_name: ""
  oauth:
    providers: []

storage:
  key_prefix: "staging/c/"

cors:
  allow_origins:
    - https://www.staging.example.com
  allow_headers: [Accept, Authorization, Content-Type, X-Request-ID, Idempotency-Key]
  expose_headers: [X-Request-ID]
  allow_credentials: true
  max_age: 10m
