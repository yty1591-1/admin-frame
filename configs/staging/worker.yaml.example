# 异步 worker 预发环境配置示例（CONFIG_STANDARDS CFG-01/07）。
# 公共段引用 ../prod/modules 基线，staging 差异集中在 modules/staging.yaml.example；
# 本文件只声明 worker 差异（无外部 HTTP、关闭幂等/限流/IAM、Outbox 批量）。
# 使用方式：cp configs/staging/worker.yaml.example configs/staging/worker.yaml

include:
  - ../prod/modules/http.yaml.example
  - ../prod/modules/log.yaml.example
  - ../prod/modules/platform.yaml.example
  - ../prod/modules/auth.yaml.example
  - ../prod/modules/infra.yaml.example
  - ../prod/modules/iam.yaml.example
  - ../prod/modules/notification.yaml.example
  - modules/staging.yaml.example

env: staging
service: worker
channel: worker
addr: ":8090" # 仅用于探针预留，不对外暴露
shutdown_timeout: 30s

http:
  trusted_proxies: []

auth:
  expected_channel: worker
  jwt:
    audience: [worker]

id:
  node_id_source: env # StatefulSet 部署可改为 statefulset，由 HOSTNAME 序号推导

worker:
  poll_interval: 5s

# worker 不接收外部写请求，幂等与限流保持关闭。
idempotency:
  enabled: false
  driver: memory

rate_limit:
  enabled: false
  driver: memory
  key: channel
  failure_mode: fail_open
  rps: 100
  burst: 200

async:
  outbox:
    batch_size: 200
    concurrency: 4
  consumer:
    concurrency: 8

# worker 不挂载 IAM：mode 必须 off。
iam:
  mode: off
  cache:
    driver: memory
  approval:
    enabled: false
  constraints:
    mode: off

# worker 不提供认证 transport，identity.enabled 必须为 false。
identity:
  enabled: false

storage:
  key_prefix: "staging/worker/"
