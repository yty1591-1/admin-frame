# 复制为 configs/worker.yaml 后按需修改；勿提交含真实密钥的 yaml（CONFIG_STANDARDS）。
env: local
service: worker
channel: worker
addr: ":8090"
shutdown_timeout: 15s

log:
  level: info
  format: json

auth:
  demo_mode: true
  expected_channel: worker

db:
  driver: memory
  dsn: ""

storage:
  driver: memory
  key_prefix: "local/worker/"
  local:
    root: ""
  s3:
    endpoint: ""
    region: ""
    bucket: ""
    force_path_style: false

worker:
  poll_interval: 5s

tracing:
  enabled: true
  exporter: none
  endpoint: ""
  insecure: false
