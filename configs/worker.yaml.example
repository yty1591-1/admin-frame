# 复制为 configs/worker.yaml 后按需修改；勿提交含真实密钥的 yaml（CONFIG_STANDARDS）。
env: local
service: worker
channel: worker
addr: ":8090"
shutdown_timeout: 15s

log:
  level: info
  format: json

auth:
  # worker 只暴露 /metrics、/healthz、/readyz，无业务路由；鉴权配置仅用于共享配置结构校验。
  mode: demo
  expected_channel: worker

# 雪花 ID 节点号：worker 不生成业务 ID，但共享同一配置结构（prod 非必填）。
id:
  node_id: 0                     # [0,1023]；多副本部署须唯一
  node_id_source: env            # env|config|statefulset

# 写请求幂等：worker 不对外提供 HTTP，保持默认关闭。
idempotency:
  enabled: false
  driver: memory
  header: Idempotency-Key
  ttl: 24h
  required: false
  max_body_bytes: 1048576

# 请求限流：worker 不对外提供 HTTP，保持默认关闭。
rate_limit:
  enabled: false
  driver: memory
  key: channel
  failure_mode: fail_open
  rps: 100
  burst: 200
  idle_ttl: 10m

# 异步基础设施：事务性 Outbox + 消费运行时（ENT-03）。
# worker 是 Outbox Relay 的独占宿主；启用前须先把 db.driver 切换为 mysql。
async:
  enabled: false                 # 默认关闭；启用要求 db.driver 非 memory
  driver: db                     # db|nats；nats 时下方 broker 必填
  broker:                        # 仅 driver=nats 生效（NATS JetStream）
    url: ""                      # nats://|tls://|ws://|wss://；prod/staging 必须 tls|wss
    stream: async                # JetStream 流名，[A-Za-z0-9_-]
    subject_prefix: async        # 主题前缀，最终 subject=<prefix>.<topic>
    ack_wait: 30s                # 确认超时，[1s, 30m]
    max_deliver: 10              # 最大投递次数，超限进 <prefix>.dlq.<topic>，[1, 100]
  outbox:
    publish_in_api: false        # worker 场景通常为 false；API 侧不得重复投递
    poll_interval: 1s
    batch_size: 100
    lease: 30s
    max_attempts: 10
    concurrency: 2
  consumer:
    concurrency: 4
    visibility_timeout: 60s
    retry_backoff: exponential   # exponential|fixed

db:
  driver: memory
  dsn: ""

storage:
  driver: memory
  key_prefix: "local/worker/"
  local:
    root: ""
  s3:
    endpoint: ""
    region: ""
    bucket: ""
    force_path_style: false

worker:
  poll_interval: 5s

tracing:
  enabled: true
  exporter: none
  endpoint: ""
  insecure: false
