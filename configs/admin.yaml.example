# 复制为 configs/admin.yaml 后按需修改；勿提交含真实密钥的 yaml（CONFIG_STANDARDS）。
# 环境变量覆盖见 docs/CONFIG_STANDARDS.md（前缀 ADMIN_FRAME_）。
env: local
service: admin-api
channel: admin
addr: ":8081"
shutdown_timeout: 15s

http:
  read_header_timeout: 5s
  read_timeout: 15s
  write_timeout: 30s
  idle_timeout: 60s
  timeout: 30s
  body_limit_bytes: 33554432

log:
  level: info
  format: json

auth:
  # demo：本地/测试专用的可伪造令牌；prod/staging 必须改为 jwt。
  # jwt 示例：
  #   mode: jwt
  #   jwt:
  #     alg: RS256
  #     issuer: https://iam.example.com
  #     audience: [admin]
  #     public_key_file: /etc/admin-frame/jwt-public.pem
  mode: demo
  expected_channel: admin

# 雪花 ID 节点号：同一集群内必须唯一，重复会生成相同 ID（ENT-02）。
id:
  node_id: 0                     # [0,1023]；prod/staging 非 worker 必须显式配置
  node_id_source: env            # env|config|statefulset；statefulset 由 HOSTNAME 末位序号推导

# 写请求幂等：仅对写方法生效（ENT-02）。
idempotency:
  enabled: false                 # 默认关闭；prod/staging 启用必须 driver=redis
  driver: memory                 # memory|redis
  header: Idempotency-Key
  ttl: 24h
  required: false                # true 时写请求缺少幂等键直接拒绝
  max_body_bytes: 1048576        # 参与指纹/缓存的请求体上限（1 MiB）

# 请求限流：按端开启（REL-05 / ENT-02）。
rate_limit:
  enabled: false
  driver: memory                 # memory|redis；prod/staging 启用必须 redis
  key: channel                   # channel|channel_user|channel_tenant_user|client
  failure_mode: fail_open        # Redis 故障时 fail_open|fail_closed
  rps: 100
  burst: 200
  idle_ttl: 10m

# 异步基础设施：事务性 Outbox + 消费运行时（ENT-03）。
async:
  enabled: false                 # 默认关闭；启用要求 db.driver 非 memory
  driver: db                     # db|nats；nats 时下方 broker 必填
  broker:                        # 仅 driver=nats 生效（NATS JetStream）
    url: ""                      # nats://|tls://|ws://|wss://；prod/staging 必须 tls|wss
    stream: async                # JetStream 流名，[A-Za-z0-9_-]
    subject_prefix: async        # 主题前缀，最终 subject=<prefix>.<topic>
    ack_wait: 30s                # 确认超时，[1s, 30m]
    max_deliver: 10              # 最大投递次数，超限进 <prefix>.dlq.<topic>，[1, 100]
  outbox:
    publish_in_api: false        # prod/staging + iam.mode=enforce 必须 false（由 worker 独占投递）
    poll_interval: 1s            # 拉取间隔，[100ms, 1m]
    batch_size: 100              # 单 worker 每轮认领上限，[1, 500]
    lease: 30s                   # processing 租约，[5s, 10m]
    max_attempts: 10             # 重试耗尽进死信，[1, 20]
    concurrency: 2               # Relay 并发 worker，[1, 16]
  consumer:
    concurrency: 4               # 消费并发度，[1, 32]
    visibility_timeout: 60s      # 幂等记录处理中接管窗口，[5s, 30m]
    retry_backoff: exponential   # exponential|fixed

# RBAC / IAM（internal/iam）。off=不启用；shadow=只比对不拦截；enforce=拦截。
iam:
  mode: shadow                   # off|shadow|enforce；prod 建议 enforce
  load_timeout: 300ms            # 回源 DB 上限，必须 ≤ 1s
  cache:
    driver: memory               # memory|redis；prod/staging + enforce 必须 redis
    l1_ttl: 3s                   # 进程内 TTL ≤ 5s（撤销最坏窗口）
    l2_ttl: 5m                   # Redis TTL ≤ 15m 且必须 > l1_ttl
    negative_ttl: 30s            # 空快照 TTL，≤ l2_ttl
    key_prefix: iam
    l1_max_entries: 10000
  limits:
    max_roles_per_subject: 20
    max_permissions_per_role: 200
    max_bindings_per_subject: 50
    max_custom_roles_per_merchant: 50
  security:
    allow_wildcard: false        # prod 强制 false；通配符只经 breakglass 展开
    require_reason: true         # 高风险变更强制填写 reason
  breakglass:
    enabled: false               # 生产默认关闭；启用要求 mode=enforce，prod 必须配置 allowed_subjects
    allowed_subjects: []         # 允许申请的主体白名单；非空时名单外返回 40300
  approval:
    enabled: false               # true 时角色 / 绑定直写端点返回 40900，必须走 change-requests
  constraints:                   # RBAC2 约束（互斥组 / 前置角色 / 基数）
    mode: shadow                 # off|shadow|enforce；空=shadow，仅记录不拦截

# 身份域认证端点（docs/identity-authn.md）；默认关闭，保持既有「只验签」行为。
# 启用前置：auth.mode=jwt（A 端必须配置 auth.jwt.keys 与 active_kid）、redis.addr 非空。
identity:
  enabled: false
  access_ttl: 15m                 # [5m, 1h]
  refresh_ttl: 168h               # 必须大于 access_ttl
  session:
    idle_timeout: 72h             # (0, refresh_ttl]
    max_per_account: 10
  revocation:
    driver: redis                 # redis 为生产唯一实现
    failure_mode: fail_closed     # fail_closed|fail_open；prod/staging 强制 fail_closed
  lockout:
    max_failures: 5
    window: 15m
    duration: 15m
  login_rate_limit:
    rps: 1
    burst: 5

# Redis：iam.cache.driver=redis 时必填；密码走 ADMIN_FRAME_REDIS_PASSWORD。
redis:
  addr: ""                       # 如 127.0.0.1:6379
  username: ""
  password: ""
  db: 0
  key_prefix: "admin-frame:"

db:
  driver: memory
  dsn: ""

# 对象存储（pkg/storage）；生产禁止 memory，密钥用环境变量注入。
storage:
  driver: memory                 # memory|local|s3|minio|oss|cos|obs
  key_prefix: "local/admin/"
  # max_object_bytes: 33554432
  # presign_put_ttl: 15m
  # presign_get_ttl: 15m
  local:
    root: ""                     # driver=local 时必填，如 ./data/objects
  s3:
    endpoint: ""                 # MinIO 例：http://127.0.0.1:9000
    region: ""
    bucket: ""
    force_path_style: false
    # access_key / secret_key → ADMIN_FRAME_STORAGE_S3_ACCESS_KEY / ADMIN_FRAME_STORAGE_S3_SECRET_KEY
  oss:
    endpoint: ""
    region: ""
    bucket: ""
    native: false               # true=阿里云 OSS 原生 SDK（L2）
  cos:
    endpoint: ""
    region: ""
    bucket: ""
    native: false               # true=腾讯云 COS 原生 SDK（L2）
  obs:
    endpoint: ""
    region: ""
    bucket: ""
    native: false               # true=华为云 OBS 原生 SDK（L2）
  # 生命周期：默认不写桶；生产开启前请确认权限与规则。
  lifecycle:
    apply_on_start: false
    # rules:
    #   - id: abort-mpu
    #     prefix: ""
    #     abort_incomplete_multipart_days: 7
    #   - id: expire-tmp
    #     prefix: tmp/
    #     expire_days: 7
  # 命名附加桶（可选）：公有静态 / 导出隔离等；键不可为 default。
  # buckets:
  #   public:
  #     driver: s3
  #     key_prefix: "local/public/"
  #     s3:
  #       bucket: admin-frame-public
  #       region: ap-southeast-1

tracing:
  # 默认启用；exporter=none 只生成 TraceID 不导出（无需 Collector）
  # 生产可改为 otlp + endpoint（如 otel-collector:4318），内网可 insecure: true
  enabled: true
  exporter: none
  endpoint: ""
  insecure: false
  # sample_ratio: 1.0
