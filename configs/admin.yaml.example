# 复制为 configs/admin.yaml 后按需修改；勿提交含真实密钥的 yaml（CONFIG_STANDARDS）。
# 环境变量覆盖见 docs/CONFIG_STANDARDS.md（前缀 ADMIN_FRAME_）。
env: local
service: admin-api
channel: admin
addr: ":8081"
shutdown_timeout: 15s

http:
  read_header_timeout: 5s
  read_timeout: 15s
  write_timeout: 30s
  idle_timeout: 60s
  timeout: 30s
  body_limit_bytes: 33554432

log:
  level: info
  format: json

auth:
  # demo：本地/测试专用的可伪造令牌；prod/staging 必须改为 jwt。
  # jwt 示例：
  #   mode: jwt
  #   jwt:
  #     alg: RS256
  #     issuer: https://iam.example.com
  #     audience: [admin]
  #     public_key_file: /etc/admin-frame/jwt-public.pem
  mode: demo
  expected_channel: admin

# RBAC / IAM（internal/iam）。off=不启用；shadow=只比对不拦截；enforce=拦截。
iam:
  mode: shadow                   # off|shadow|enforce；prod 建议 enforce
  load_timeout: 300ms            # 回源 DB 上限，必须 ≤ 1s
  cache:
    driver: memory               # memory|redis；prod/staging + enforce 必须 redis
    l1_ttl: 3s                   # 进程内 TTL ≤ 5s（撤销最坏窗口）
    l2_ttl: 5m                   # Redis TTL ≤ 15m 且必须 > l1_ttl
    negative_ttl: 30s            # 空快照 TTL，≤ l2_ttl
    key_prefix: iam
    l1_max_entries: 10000
  limits:
    max_roles_per_subject: 20
    max_permissions_per_role: 200
    max_bindings_per_subject: 50
    max_custom_roles_per_merchant: 50
  security:
    allow_wildcard: false        # prod 强制 false；通配符只经 breakglass 展开
    require_reason: true         # 高风险变更强制填写 reason

# Redis：iam.cache.driver=redis 时必填；密码走 ADMIN_FRAME_REDIS_PASSWORD。
redis:
  addr: ""                       # 如 127.0.0.1:6379
  username: ""
  password: ""
  db: 0
  key_prefix: "admin-frame:"

db:
  driver: memory
  dsn: ""

# 对象存储（pkg/storage）；生产禁止 memory，密钥用环境变量注入。
storage:
  driver: memory                 # memory|local|s3|minio|oss|cos|obs
  key_prefix: "local/admin/"
  # max_object_bytes: 33554432
  # presign_put_ttl: 15m
  # presign_get_ttl: 15m
  local:
    root: ""                     # driver=local 时必填，如 ./data/objects
  s3:
    endpoint: ""                 # MinIO 例：http://127.0.0.1:9000
    region: ""
    bucket: ""
    force_path_style: false
    # access_key / secret_key → ADMIN_FRAME_STORAGE_S3_ACCESS_KEY / ADMIN_FRAME_STORAGE_S3_SECRET_KEY
  oss:
    endpoint: ""
    region: ""
    bucket: ""
    native: false               # true=阿里云 OSS 原生 SDK（L2）
  cos:
    endpoint: ""
    region: ""
    bucket: ""
    native: false               # true=腾讯云 COS 原生 SDK（L2）
  obs:
    endpoint: ""
    region: ""
    bucket: ""
    native: false               # true=华为云 OBS 原生 SDK（L2）
  # 生命周期：默认不写桶；生产开启前请确认权限与规则。
  lifecycle:
    apply_on_start: false
    # rules:
    #   - id: abort-mpu
    #     prefix: ""
    #     abort_incomplete_multipart_days: 7
    #   - id: expire-tmp
    #     prefix: tmp/
    #     expire_days: 7
  # 命名附加桶（可选）：公有静态 / 导出隔离等；键不可为 default。
  # buckets:
  #   public:
  #     driver: s3
  #     key_prefix: "local/public/"
  #     s3:
  #       bucket: admin-frame-public
  #       region: ap-southeast-1

tracing:
  # 默认启用；exporter=none 只生成 TraceID 不导出（无需 Collector）
  # 生产可改为 otlp + endpoint（如 otel-collector:4318），内网可 insecure: true
  enabled: true
  exporter: none
  endpoint: ""
  insecure: false
  # sample_ratio: 1.0
