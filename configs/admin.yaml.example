# 复制为 configs/admin.yaml 后按需修改；勿提交含真实密钥的 yaml（CONFIG_STANDARDS）。
# 环境变量覆盖见 docs/CONFIG_STANDARDS.md（前缀 ADMIN_FRAME_）。
env: local
service: admin-api
channel: admin
addr: ":8081"
shutdown_timeout: 15s

log:
  level: info
  format: json

auth:
  # 演示用：Authorization: Bearer admin.<subject_id>
  # 生产应替换为独立 JWT issuer/audience/密钥
  demo_mode: true
  expected_channel: admin

db:
  driver: memory
  dsn: ""
