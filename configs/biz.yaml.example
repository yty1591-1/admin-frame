# 复制为 configs/biz.yaml 后按需修改；勿提交含真实密钥的 yaml（CONFIG_STANDARDS）。
env: local
service: biz-api
channel: biz
addr: ":8082"
shutdown_timeout: 15s

log:
  level: info
  format: json

auth:
  # 演示用：Authorization: Bearer biz.<merchant_id>.<subject_id>
  demo_mode: true
  expected_channel: biz

db:
  driver: memory
  dsn: ""
