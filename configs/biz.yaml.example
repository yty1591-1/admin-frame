# 复制为 configs/biz.yaml 后按需修改；勿提交含真实密钥的 yaml（CONFIG_STANDARDS）。
env: local
service: biz-api
channel: biz
addr: ":8082"
shutdown_timeout: 15s

http:
  read_header_timeout: 5s
  read_timeout: 15s
  write_timeout: 30s
  idle_timeout: 60s
  timeout: 30s
  body_limit_bytes: 33554432

log:
  level: info
  format: json

auth:
  # demo：本地/测试专用；prod/staging 必须改为 jwt。
  #   mode: jwt
  #   jwt: {alg: HS256, issuer: https://iam.example.com, audience: [biz]}
  #   （HS256 密钥走 ADMIN_FRAME_AUTH_JWT_SECRET，长度 ≥32 字节）
  mode: demo
  expected_channel: biz

# 雪花 ID 节点号：同一集群内必须唯一，重复会生成相同 ID（ENT-02）。
id:
  node_id: 0                     # [0,1023]；prod/staging 非 worker 必须显式配置
  node_id_source: env            # env|config|statefulset；statefulset 由 HOSTNAME 末位序号推导

# 写请求幂等：仅对写方法生效（ENT-02）。
idempotency:
  enabled: false                 # 默认关闭；prod/staging 启用必须 driver=redis
  driver: memory                 # memory|redis
  header: Idempotency-Key
  ttl: 24h
  required: false                # true 时写请求缺少幂等键直接拒绝
  max_body_bytes: 1048576        # 参与指纹/缓存的请求体上限（1 MiB）

# 请求限流：按端开启（REL-05 / ENT-02）。
rate_limit:
  enabled: false
  driver: memory                 # memory|redis；prod/staging 启用必须 redis
  key: channel                   # channel|channel_user|channel_tenant_user|client
  failure_mode: fail_open        # Redis 故障时 fail_open|fail_closed
  rps: 100
  burst: 200
  idle_ttl: 10m

# 异步基础设施：事务性 Outbox + 消费运行时（ENT-03）。
async:
  enabled: false                 # 默认关闭；启用要求 db.driver 非 memory
  driver: db                     # db（唯一实现）；broker(NATS/Kafka) 仅预留接口
  outbox:
    publish_in_api: false        # prod/staging + iam.mode=enforce 必须 false（由 worker 独占投递）
    poll_interval: 1s
    batch_size: 100
    lease: 30s
    max_attempts: 10
    concurrency: 2
  consumer:
    concurrency: 4
    visibility_timeout: 60s
    retry_backoff: exponential   # exponential|fixed

db:
  driver: memory
  dsn: ""

storage:
  driver: memory
  key_prefix: "local/biz/"
  local:
    root: ""
  s3:
    endpoint: ""
    region: ""
    bucket: ""
    force_path_style: false

tracing:
  enabled: true
  exporter: none
  endpoint: ""
  insecure: false

# B 端 IAM：只挂 /biz/v1/iam/*，审批端点不注册；破玻璃仅 A 端可用。
iam:
  mode: shadow                   # off|shadow|enforce；prod 建议 enforce
  load_timeout: 300ms
  cache:
    driver: memory               # prod/staging + enforce 必须 redis
    l1_ttl: 3s
    l2_ttl: 5m
    negative_ttl: 30s
    key_prefix: iam
    l1_max_entries: 10000
  limits:
    max_roles_per_subject: 20
    max_permissions_per_role: 200
    max_bindings_per_subject: 50
    max_custom_roles_per_merchant: 50
  security:
    allow_wildcard: false
    require_reason: true
  breakglass:
    enabled: false               # B 端不可启用：配置校验要求 channel=admin
    allowed_subjects: []
  approval:
    enabled: false               # true 时角色 / 绑定直写端点返回 40900，必须走 change-requests

# 身份域认证端点（docs/identity-authn.md）；默认关闭，保持既有「只验签」行为。
# 启用前置：auth.mode=jwt、redis.addr 非空（需补充 redis 段）、生产必须 fail_closed。
identity:
  enabled: false
  access_ttl: 15m                 # [5m, 1h]
  refresh_ttl: 168h               # 必须大于 access_ttl
  session:
    idle_timeout: 72h             # (0, refresh_ttl]
    max_per_account: 10
  revocation:
    driver: redis                 # redis 为生产唯一实现
    failure_mode: fail_closed     # fail_closed|fail_open；prod/staging 强制 fail_closed
  lockout:
    max_failures: 5
    window: 15m
    duration: 15m
  login_rate_limit:
    rps: 1
    burst: 5
