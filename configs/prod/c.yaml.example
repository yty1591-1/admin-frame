# C 端（c-api）生产环境配置示例（CONFIG_STANDARDS CFG-01/03/05/06）。
# 公共段按领域拆分在 modules/，本文件只声明 C 端差异（channel/audience/CORS/node_id/
# 上传上限、消费并发、IAM 关闭）。
# 使用方式：复制为 configs/prod-c.yaml，并把 include 路径改为 prod/modules/...；
# 密钥全部由环境变量注入，随机示例值见 configs/prod/env.example。
# 身份域开启后生产必须具备短信或 OAuth 提供方，且禁止 memory 驱动，详见 modules/identity。

include:
  - modules/http.yaml.example
  - modules/log.yaml.example
  - modules/platform.yaml.example
  - modules/auth.yaml.example
  - modules/infra.yaml.example
  - modules/iam.yaml.example
  - modules/identity.yaml.example

env: prod
service: c-api
channel: c
addr: ":8083"
shutdown_timeout: 20s

auth:
  expected_channel: c # 必须与 channel 一致，防止 A/B 令牌串用
  jwt:
    audience: [c]

id:
  node_id: 2 # C 端多副本必须逐副本唯一；建议 statefulset 推导

http:
  body_limit_bytes: 33554432 # C 端上传场景较多，设为 32 MiB

async:
  consumer:
    concurrency: 8 # C 端通知/异步任务量更大，消费并发上调

# C 端不挂载 IAM：mode 必须 off（启动校验会拒绝其他取值）。
iam:
  mode: off
  cache:
    driver: memory
  approval:
    enabled: false
  constraints:
    mode: off

# prod baseline 关闭；开启时按 modules/identity 注入 hash_key / subject.keys，
# 并至少配置 sms 或一个 oauth provider（prod 校验强制）。
identity:
  enabled: false
  mfa:
    admin_required: false # 仅 A 端支持 MFA
  # 短信验证码登录：仅 C 端支持；开启时 driver 不得为 memory，daily_budget 必须 > 0。
  sms:
    enabled: false # 开启时改 true
    driver: aliyun # memory 仅本地/测试；prod 禁止
    template_id: "" # 厂商模板编码；enabled=true 时必填
    sign_name: "" # 已审核通过的短信签名；国际短信可为空
    locale: zh-CN # 语言/地区提示
    default_region: "" # 如 CN；配置后允许本地号码自动补国家码
    quota_timezone: Asia/Shanghai # 日配额/预算时区；空表示 UTC
    code_ttl: 5m # (0, 15m]
    max_attempts: 5 # [1, 10]
    resend_interval: 60s # (0, code_ttl]
    daily_per_phone: 10 # >= 1
    hourly_per_ip: 30 # >= 1
    daily_budget: 10000 # 全局日预算；prod/staging 必须 > 0
    breaker_failures: 5 # 连续失败阈值；0 使用默认 5
    breaker_timeout: 60s # 熔断时长，[1s, 10m]
  # 第三方授权登录：providers 非空时仅 C 端允许，且密钥通过 client_secret_env 指向的环境变量注入。
  oauth:
    auto_provision: false # 未映射身份不自动建号（失败关闭）
    timeout: 5s # 单次回源超时，[1s, 30s]
    breaker_failures: 5 # >= 0
    breaker_timeout: 60s # [1s, 10m]
    rate_limit:
      rps: 1 # 0 使用默认 1
      burst: 5 # 0 使用默认 5
      ip_rps: 0 # 0 表示不启用 IP 维度
      ip_burst: 0 # 0 表示不启用 IP 维度
      failure_mode: fail_closed # prod/staging 强制 fail_closed
    providers: [] # 每项 name/client_id/client_secret_env/auth_url/token_url/userinfo_url/redirect_uri/scopes/subject_field

storage:
  key_prefix: "prod/c/"

cors:
  allow_origins:
    - https://www.example.com
    - https://m.example.com
  allow_headers: [Accept, Authorization, Content-Type, X-Request-ID, Idempotency-Key] # 空则用中间件默认（不含幂等键）
  expose_headers: [X-Request-ID] # 浏览器可读的响应头
  allow_credentials: true # 与 "*" 互斥
  max_age: 10m # 预检缓存；<= 0 不写该响应头
