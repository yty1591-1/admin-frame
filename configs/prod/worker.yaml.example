# 异步 worker 生产环境配置示例（CONFIG_STANDARDS CFG-01/03/05/06）。
# 公共段按领域拆分在 modules/，本文件只声明 worker 差异（无外部 HTTP、关闭幂等/限流/IAM、
# Outbox 批量上调）。
# 使用方式：复制为 configs/prod-worker.yaml，并把 include 路径改为 prod/modules/...；
# 密钥全部由环境变量注入，随机示例值见 configs/prod/env.example。
# worker 是 Outbox Relay 与消费任务的独占宿主，API 侧 async.outbox.publish_in_api=false。

include:
  - modules/http.yaml.example
  - modules/log.yaml.example
  - modules/platform.yaml.example
  - modules/auth.yaml.example
  - modules/infra.yaml.example
  - modules/iam.yaml.example

env: prod
service: worker
channel: worker
addr: ":8090" # 仅用于进程内调试 / 探针预留，不对外暴露
shutdown_timeout: 30s # 给未完成的 relay 批次留出退出时间

http:
  trusted_proxies: []

# worker 不提供 HTTP；但 prod 禁止 demo，且校验要求 audience 包含 channel。
auth:
  expected_channel: worker
  jwt:
    audience: [worker]

id:
  node_id: 3 # worker 非必填，但多副本时仍须唯一

# worker.poll_interval 是历史字段，仅写入启动日志快照；Outbox 轮询实际由
# async.outbox.poll_interval 控制，两者不要同时调整。
worker:
  poll_interval: 5s

# worker 不接收外部写请求，幂等与限流保持关闭。
idempotency:
  enabled: false
  driver: memory

rate_limit:
  enabled: false
  driver: memory
  key: channel
  failure_mode: fail_open
  rps: 100
  burst: 200

async:
  outbox:
    batch_size: 200 # worker 可高于 API 默认批次
    concurrency: 4 # 多副本时按总吞吐调整，注意租约竞争
  consumer:
    concurrency: 8

# worker 不挂载 IAM：mode 必须 off。
iam:
  mode: off
  cache:
    driver: memory
  approval:
    enabled: false
  constraints:
    mode: off

# worker 不提供认证 transport，identity.enabled 必须为 false（启动校验会拒绝 worker 开启）。
identity:
  enabled: false

storage:
  key_prefix: "prod/worker/"
