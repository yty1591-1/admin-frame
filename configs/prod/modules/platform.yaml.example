# 平台运行时基线：雪花 ID、幂等、限流、异步 Outbox。
# node_id 必须逐进程唯一，由各端服务文件声明；worker 关闭幂等 / 限流。
id:
  node_id_source: env # env | config | statefulset；statefulset 由 HOSTNAME 推导

# 写请求幂等：prod/staging 启用时必须 driver=redis（启动校验强制）。
idempotency:
  enabled: true # 默认关闭，按端开启
  driver: redis # memory | redis
  header: Idempotency-Key # 幂等键请求头；非空
  ttl: 24h # 幂等记录保留期，> 0
  required: false # true 时缺幂等键的写请求会被直接拒绝
  max_body_bytes: 1048576 # 参与去重比对的最大请求体（字节）

# 请求限流：prod/staging 启用时必须 redis；fail_closed 在 Redis 故障时拒绝新请求。
rate_limit:
  enabled: true # 默认关闭，按端开启
  driver: redis # memory | redis
  key: channel_user # channel|channel_user|channel_tenant_user|client
  failure_mode: fail_closed # fail_open | fail_closed
  rps: 200 # 每秒补充令牌数，> 0
  burst: 400 # 桶容量，>= 1
  idle_ttl: 10m # 空闲桶回收阈值；0 使用 10m

# 异步基础设施：事务性 Outbox；IAM enforce 时 API 侧不得自行投递，由 worker 独占 relay。
async:
  enabled: true # 默认 false；启用要求 db.driver != memory
  driver: db # db | nats；nats 需 tls:// 或 wss://
  broker: # 仅 driver=nats 使用；db 模式下保留默认值
    url: "" # NATS 地址；driver=nats 时必填
    stream: async # JetStream stream 名
    subject_prefix: async # 事件 subject 前缀
    ack_wait: 30s # 单条消息 ack 上限
    max_deliver: 10 # 最大投递次数
  outbox:
    publish_in_api: false # prod + IAM enforce 必须 false
    poll_interval: 1s # [100ms, 1m]
    batch_size: 100 # [1, 500]
    lease: 30s # processing 租约，[5s, 10m]
    max_attempts: 10 # [1, 20]
    concurrency: 2 # [1, 16]
  consumer:
    concurrency: 4 # [1, 32]
    visibility_timeout: 60s # [5s, 30m]
    retry_backoff: exponential # exponential | fixed

# 审计存储、查询与保留（ENT-04 / AUDIT_STANDARDS）。
# store=db 才具备查询与导出能力；prod 启动校验拒绝 log（审计不可查即不合规）。
audit:
  store: db # auto | db | log；auto 按 db.driver 自动选择
  retention_days: 180 # 不得低于 AUD-07 基线 180 天；支付类 365 天由组织策略覆盖
  legal_hold: false # true 时保留任务只统计不删除（法务保留期）
  query:
    max_range_days: 31 # 单次查询最大跨度；无时间窗查询一律 40000
    default_page_size: 20
    max_page_size: 100 # 与 API-05 上限一致
  export:
    max_range_days: 31 # 单次导出最大跨度
    max_rows: 50000 # 超限拒绝而不是静默截断
  retention:
    batch_size: 5000 # [100, 50000]
    cleanup_interval: 24h # >= 1m；worker 独占执行
    dry_run: false # 首次上线建议先 true 观察到期量

# 密钥托管（ENT-07 T4 / SECURITY_STANDARDS §10.3）。
# 生产密钥由 K8s Secret 以文件形式投影到 secrets.file.dir，文件名即密钥逻辑名
# （db_dsn / auth_jwt_secret / identity_hash_key ...）。FileProvider 命中即覆盖
# 配置文件与环境变量的值，使「密钥来自托管源」可被验证。
# 禁止仅用环境变量：环境变量会进入 /proc/<pid>/environ、子进程环境与崩溃转储。
secrets:
  providers: [file] # env | file；按序尝试，首个命中生效
  allow_env_fallback: true # 迁移期兜底：file 未命中的密钥回落到 ADMIN_FRAME_*
  # ↓ 全部密钥确认可由文件提供后置 false —— 此后缺失密钥直接阻断启动。
  # 切换步骤见 docs/runbooks/key-rotation.md「迁移到托管源」。
  file:
    dir: "/var/run/secrets/admin-frame" # 与 values-prod.yaml secretMounts.mountPath 一致
  env:
    prefix: ADMIN_FRAME # 变量名 <prefix>_<NAME 大写>，与 pkg/config.BindEnv 同源
