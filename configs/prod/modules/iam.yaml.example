# IAM 基线：生产目标 enforce。
# C 端与 worker 不挂载 IAM，服务文件覆盖为 mode=off、cache.driver=memory、constraints.mode=off。
# 首次上线若尚无生效绑定，enforce 会拒绝所有业务请求；先以 shadow 观察再切换。
iam:
  mode: enforce # off | shadow | enforce
  load_timeout: 300ms # 回源 DB 上限，必须 <= 1s
  cache:
    driver: redis # memory | redis；enforce + prod 必须 redis
    l1_ttl: 3s # 进程内缓存
    l2_ttl: 5m # Redis 共享缓存
    negative_ttl: 30s # 未命中缓存，防穿透
    key_prefix: iam # 与其他业务共用 Redis 时的键隔离
    l1_max_entries: 10000 # L1 最大条目
  limits:
    max_roles_per_subject: 20 # 限制每个主体角色数，防止角色爆炸
    max_permissions_per_role: 200 # 限制每个角色权限数，防止权限爆炸
    max_bindings_per_subject: 50 # 限制每个主体绑定数，防止绑定爆炸
    max_custom_roles_per_merchant: 50 # 限制每个商户自定义角色数，防止角色爆炸
  security:
    allow_wildcard: false # prod 强制 false；通配符只允许经破玻璃临时展开
    require_reason: true # 高风险操作必须填写原因
  breakglass:
    enabled: false # 启用要求 mode=enforce 且配置 allowed_subjects
    allowed_subjects: [] # 破玻璃授权主体白名单
  approval:
    enabled: true # 高风险角色/绑定变更强制走审批单
  constraints:
    mode: enforce # off | enforce；RBAC2 互斥组 / 前置角色 / 基数约束
