# 通知渠道基线（ENT-10 NT-04）。
#
# driver 取值：memory | smtp | aliyun | apns | fcm | disabled。
# prod / staging 禁止 memory（只记录不出网，会让邀请与业务通知静默丢失）；
# 未使用的渠道必须显式 disabled，避免「忘配」被误当作「已关闭」。
# 所有凭据只提供「环境变量名」（*_env），值由 Secret 注入，禁止写明文。
notification:
  channels:
    email:
      driver: smtp
      from: no-reply@example.com # 必须是 SMTP 账号允许的发件地址
      from_name: AdminFrame
      smtp:
        host: smtp.example.com
        port: 587
        encryption: starttls # starttls（默认）| tls
        auth: plain # plain（默认）| login
        username: no-reply@example.com
        password_env: ADMIN_FRAME_NOTIFICATION_SMTP_PASSWORD
        tls_min_version: "1.2"
    sms:
      # 接入阿里云短信后把 driver 改为 aliyun，并补齐 template_id / sign_name /
      # aliyun.access_key_id / aliyun.access_key_secret_env。
      driver: disabled
      template_id: ""
      sign_name: ""
      aliyun:
        endpoint: https://dysmsapi.aliyuncs.com
        region: cn-hangzhou
        access_key_id: ""
        access_key_secret_env: ALIYUN_SMS_ACCESS_KEY_SECRET
        sign_name: ""
    push:
      # 接入 APNs 或 FCM 后把 driver 改为 apns / fcm，并补齐对应凭据环境变量。
      driver: disabled
      platform: "" # apns → ios；fcm → android
      apns:
        endpoint: https://api.push.apple.com
        topic: ""
        key_id: ""
        team_id: ""
        private_key_env: ADMIN_FRAME_NOTIFICATION_APNS_PRIVATE_KEY
        push_type: alert
      fcm:
        endpoint: https://fcm.googleapis.com
        project_id: ""
        credentials_json_env: ADMIN_FRAME_NOTIFICATION_FCM_CREDENTIALS
