# B 端（biz-api）生产环境配置示例（CONFIG_STANDARDS CFG-01/03/05/06）。
# 公共段按领域拆分在 modules/，本文件只声明 B 端差异（channel/audience/CORS/node_id/限流分桶）。
# 使用方式：复制为 configs/prod-biz.yaml，并把 include 路径改为 prod/modules/...；
# 密钥全部由环境变量注入，随机示例值见 configs/prod/env.example。
# IAM enforce 需要商户级角色与绑定数据，首次上线建议先 shadow 再切 enforce。

include:
  - modules/http.yaml.example
  - modules/log.yaml.example
  - modules/platform.yaml.example
  - modules/auth.yaml.example
  - modules/infra.yaml.example
  - modules/iam.yaml.example
  - modules/identity.yaml.example

env: prod
service: biz-api
channel: biz
addr: ":8082"
shutdown_timeout: 20s

auth:
  expected_channel: biz # 必须与 channel 一致；B 端令牌不得被 A/C 端接受
  jwt:
    audience: [biz]

id:
  node_id: 1 # 每个副本唯一；多副本生产建议 node_id_source=statefulset

rate_limit:
  key: channel_tenant_user # B 端按 商户+用户 分桶，避免跨商户争抢配额
  rps: 100
  burst: 200

# prod baseline 关闭；开启时按 modules/identity 注入 hash_key，并保持 mfa=false。
identity:
  enabled: false
  mfa:
    admin_required: false # 仅 A 端支持 MFA；B 端配置 true 会被启动校验拒绝

storage:
  key_prefix: "prod/biz/"

cors:
  allow_origins:
    - https://biz.example.com
  allow_headers: [Accept, Authorization, Content-Type, X-Request-ID, Idempotency-Key] # 空则用中间件默认（不含幂等键）
  expose_headers: [X-Request-ID] # 浏览器可读的响应头
  allow_credentials: true # 与 "*" 互斥
  max_age: 10m # 预检缓存；<= 0 不写该响应头
