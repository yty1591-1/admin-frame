# 生产环境环境变量示例（对应 configs/prod/*.yaml.example）。
#
#    安全声明：以下所有值都是随机生成的“演练值”，仅用于本地/预发验证生产配置能否启动，
#    并且已经写入本仓库 → 视同已泄露，绝对不能用于真实生产。
#    真实生产必须由 Secret Manager / KMS / Vault 生成并注入（SEC-01、CFG-06）。
#
# 使用方式（PowerShell，逐行注入当前会话）：
#   Get-Content configs\prod\env.example | ForEach-Object {
#     if ($_ -match '^([A-Z0-9_]+)=(.+)$') { Set-Item -Path "Env:$($matches[1])" -Value $matches[2] }
#   }
#
# 变量名与字段映射见 docs/CONFIG_STANDARDS.md；配置文件中的空值字段均由下列变量填充。
#
# 密钥托管（ENT-07）：生产基线已改为「K8s Secret 挂载为文件」优先，见
# configs/prod/modules/platform.yaml.example 的 secrets 段。本文件中的密钥变量
# 仅作为迁移期兜底（secrets.allow_env_fallback=true）。迁移完成后应逐项删除，
# 步骤见 docs/runbooks/key-rotation.md「迁移到托管源」。

# ---- 运行环境 ---------------------------------------------------------------
# 配置文件中已写 env: prod；此处显式设置用于防止误加载其他环境的配置。
ADMIN_FRAME_ENV=prod

# ---- MySQL ---------------------------------------------------------------
# 生产要求：独立迁移账号与运行账号分离；DSN 必须 parseTime=true 且 loc=UTC。
# 密码为随机生成（24 位大小写字母+数字）。
ADMIN_FRAME_DB_DRIVER=mysql
ADMIN_FRAME_DB_DSN=admin_frame:CHVcDDmfFbW8oc7GBnYFUMhy@tcp(mysql.prod.internal:3306)/admin_frame?parseTime=true&loc=UTC&charset=utf8mb4

# ---- Redis ---------------------------------------------------------------
# 生产使用哨兵/集群时填集群入口；密码为随机生成的 48 位十六进制（24 字节）。
ADMIN_FRAME_REDIS_ADDR=redis.prod.internal:6379
ADMIN_FRAME_REDIS_PASSWORD=fd51b4775c2cc81269accb4e1c511c7f4393d159927c95c8

# ---- JWT ---------------------------------------------------------------
# HS256 单密钥：至少 32 字节；下方为随机 64 位十六进制（32 字节）。
# 生产推荐 RS256 密钥环：此时删除本变量，改用配置文件中的 keys + public_key_file，
# 私钥仅用于身份域签发令牌，且必须由 Secret 挂载（禁止进入镜像/仓库）。
ADMIN_FRAME_AUTH_JWT_SECRET=ca24256120caa7c42ccaa14f43aa56c8a3d72b4b3cd2ac88b51ed2492101d753

# ---- 对象存储（S3 兼容）---------------------------------------------------
# 生产必须使用 IAM Role / 临时凭证或专属 AK/SK；下方为随机演练值。
ADMIN_FRAME_STORAGE_S3_ACCESS_KEY=AFPRODMNFN5QQZBGXY
ADMIN_FRAME_STORAGE_S3_SECRET_KEY=878d6f395e595e146fd395418bfe4d9cdf0a596cda8ecb88f85b4d95de402c77

# ---- 身份域（三端已开启 identity.enabled=true）--------------------------------
# hash_key：32 字节，用于手机号/邮箱/IP/UA 的带密钥摘要（IDN-P1-06），下方为随机 64 位十六进制。
ADMIN_FRAME_IDENTITY_HASH_KEY=7a1ec0f4290851c052cee9fb3b972bc5a8c14297c65e4301bb320b3e6f426454
# mfa.secret_key：32 字节，用于 AES-GCM 加密 TOTP 密钥，下方为随机 64 位十六进制（A 端强制 MFA）。
ADMIN_FRAME_IDENTITY_MFA_SECRET_KEY=a0c1663bfcdb9f923a4d7171709b6b0d36ab2298053a36f4c26cf7a3b5c17c8a
# C 端短信登录（identity.sms.driver=aliyun）：AK/SK 必须由云厂商签发，无法随机生成，下方为占位值。
ALIYUN_SMS_ACCESS_KEY_ID=REPLACE_WITH_ALIYUN_AK
ALIYUN_SMS_ACCESS_KEY_SECRET=REPLACE_WITH_ALIYUN_SK

# ---- 首个管理员 ------------------------------------------------------------
# 账号、密码凭据与 system_admin 绑定由 A 端 admin-api 启动时 bootstrap.EnsureAdmin 幂等创建；
# 迁移 000005 只负责角色、权限与数据范围种子，不写账号数据。
# 首次登录强制改密，再按 A 端策略完成 MFA 绑定；无需 seed CLI 或额外环境变量。

# ---- 按进程注入的非密钥变量（不要放在共享 Secret 中）------------------------
# 每个副本的 node_id 必须唯一；多副本推荐 id.node_id_source=statefulset，由 HOSTNAME 推导。
# ADMIN_FRAME_ID_NODE_ID=0        # admin
# ADMIN_FRAME_ID_NODE_ID=1        # biz
# ADMIN_FRAME_ID_NODE_ID=2        # c
# ADMIN_FRAME_ID_NODE_ID=3        # worker

# ---- 迁移专用（一次性 Job）------------------------------------------------
# 建议使用独立账号，仅授予 DDL 权限；应用账号只保留 DML。
# ADMIN_FRAME_DB_DSN=admin_frame_migrator:<DDL账号随机口令>@tcp(mysql.prod.internal:3306)/admin_frame?parseTime=true&loc=UTC&charset=utf8mb4
