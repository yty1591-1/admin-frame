# A 端（admin-api）生产环境配置示例（CONFIG_STANDARDS CFG-01/03/05/06）。
# 公共段按领域拆分在 modules/，本文件只声明 A 端差异（service/channel/addr/audience/node_id/CORS）。
# 使用方式：复制为 configs/prod-admin.yaml，并把 include 路径改为 prod/modules/...；
# 密钥全部由环境变量注入，完整变量清单见 configs/prod/env.example。
# 本示例对齐 deploy/helm/admin-frame/values-prod.yaml 的基线；identity 默认关闭，
# 开启前置条件见 modules/identity.yaml.example。

include:
  - modules/http.yaml.example
  - modules/log.yaml.example
  - modules/platform.yaml.example
  - modules/auth.yaml.example
  - modules/infra.yaml.example
  - modules/iam.yaml.example
  - modules/identity.yaml.example
  - modules/notification.yaml.example

env: prod
service: admin-api
channel: admin
addr: ":8081" # 容器内由 Chart 注入 :8080；本地多进程演练用 :8081
shutdown_timeout: 20s

auth:
  expected_channel: admin # 必须与 channel 完全一致，防止跨端令牌串用
  jwt:
    audience: [admin]

# 雪花 ID：同一集群内所有进程 node_id 必须唯一；多副本用 statefulset 由 HOSTNAME 推导。
id:
  node_id: 0 # [0,1023]；prod 非 worker 必填

# 生产开启身份域（IDN-GAP-P0-01）：前置 auth.mode=jwt、redis、mysql、
# async.enabled=true，且注入 hash_key / mfa.secret_key；subject.keys 可选，
# 配置后必须同时指定 active_key_id。A 端强制 MFA（mfa.admin_required=true）。
identity:
  enabled: true

storage:
  key_prefix: "prod/admin/"

# CORS：生产必须显式 Origin，禁止 "*"；与 allow_credentials 互斥。
cors:
  allow_origins:
    - https://admin.example.com
  allow_headers: [Accept, Authorization, Content-Type, X-Request-ID, Idempotency-Key] # 空则用中间件默认（不含幂等键）
  expose_headers: [X-Request-ID] # 浏览器可读的响应头
  allow_credentials: true # 与 "*" 互斥
  max_age: 10m # 预检缓存；<= 0 不写该响应头
