# 开发环境环境变量示例（对应 configs/dev/*.yaml.example）。
#
#    安全声明：以下值仅用于本地开发，已写入仓库 → 视同已泄露，
#    绝对不能用于 staging / prod（CFG-06）。
#
# 使用方式（PowerShell，逐行注入当前会话）：
#   Get-Content configs\dev\env.example | ForEach-Object {
#     if ($_ -match '^([A-Z0-9_]+)=(.+)$') { Set-Item -Path "Env:$($matches[1])" -Value $matches[2] }
#   }
#
# dev 只依赖 MySQL（async / audit 需要持久化）；Redis 留空，幂等 / 限流 / IAM 缓存
# 走进程内实现。storage 使用 local 驱动，无需对象存储。

# ---- 运行环境 ---------------------------------------------------------------
# 配置文件中已写 env: dev；此处显式设置用于防止误加载其他环境的配置。
ADMIN_FRAME_ENV=dev

# ---- MySQL ---------------------------------------------------------------
ADMIN_FRAME_DB_DRIVER=mysql
ADMIN_FRAME_DB_DSN=admin_frame:devpass@tcp(127.0.0.1:3306)/admin_frame?parseTime=true&loc=UTC&charset=utf8mb4

# ---- JWT（HS256，>= 32 字节）-----------------------------------------------
ADMIN_FRAME_AUTH_JWT_SECRET=dev-only-0123456789abcdef0123456789abcdef

# ---- 通知运行时（c-api / worker 启动期 fail-closed 校验项）------------------
ADMIN_FRAME_NOTIFICATION_CALLBACK_SECRET=dev-only-callback-secret-0123456789abcdef
ADMIN_FRAME_NOTIFICATION_BLACKLIST_SALT=dev-only-blacklist-salt-0123456789abcdef

# ---- 按进程注入 -------------------------------------------------------------
# 单进程调试可省略；同机多进程演练时逐进程设置，与各服务文件的 id.node_id 一致。
# ADMIN_FRAME_ID_NODE_ID=0        # admin
# ADMIN_FRAME_ID_NODE_ID=1        # biz
# ADMIN_FRAME_ID_NODE_ID=2        # c
# ADMIN_FRAME_ID_NODE_ID=3        # worker
