# C 端（c-api）开发环境配置示例（CONFIG_STANDARDS CFG-01/07）。
# 公共段引用 ../prod/modules 基线，dev 差异集中在 modules/dev.yaml.example；
# 本文件只声明 C 端差异（channel/audience/CORS/node_id/上传上限/IAM 关闭）。
# 使用方式：cp configs/dev/c.yaml.example configs/dev/c.yaml
# 身份域默认关闭；本地联调可开启 sms.enabled 并用 memory 驱动（dev 允许）。

include:
  - ../prod/modules/http.yaml.example
  - ../prod/modules/log.yaml.example
  - ../prod/modules/platform.yaml.example
  - ../prod/modules/auth.yaml.example
  - ../prod/modules/infra.yaml.example
  - ../prod/modules/iam.yaml.example
  - ../prod/modules/identity.yaml.example
  - modules/dev.yaml.example

env: dev
service: c-api
channel: c
addr: ":8083"
shutdown_timeout: 20s

auth:
  expected_channel: c # 必须与 channel 一致，防止 A/B 令牌串用
  jwt:
    audience: [c]

id:
  node_id: 2 # 多进程演练时逐进程唯一

http:
  body_limit_bytes: 33554432 # C 端上传场景较多，设为 32 MiB

async:
  consumer:
    concurrency: 8 # C 端通知/异步任务量更大

# C 端不挂载 IAM：mode 必须 off（启动校验会拒绝其他取值）。
iam:
  mode: off
  cache:
    driver: memory
  approval:
    enabled: false
  constraints:
    mode: off

identity:
  enabled: false
  mfa:
    admin_required: false
  # 本地验证短信链路：enabled: true + driver: memory（dev 允许，staging / prod 禁止）。
  sms:
    enabled: false
    driver: memory
    template_id: ""
    sign_name: ""
  oauth:
    providers: []

storage:
  key_prefix: "dev/c/"

cors:
  allow_origins:
    - http://localhost:5173
    - http://localhost:3000
  allow_headers: [Accept, Authorization, Content-Type, X-Request-ID, Idempotency-Key]
  expose_headers: [X-Request-ID]
  allow_credentials: true
  max_age: 10m
