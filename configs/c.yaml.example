# 复制为 configs/c.yaml 后按需修改；勿提交含真实密钥的 yaml（CONFIG_STANDARDS）。
env: local
service: c-api
channel: c
addr: ":8083"
shutdown_timeout: 15s

http:
  read_header_timeout: 5s
  read_timeout: 15s
  write_timeout: 30s
  idle_timeout: 60s
  timeout: 30s
  body_limit_bytes: 33554432

log:
  level: info
  format: json

auth:
  # demo：本地/测试专用；prod/staging 必须改为 jwt。
  #   mode: jwt
  #   jwt: {alg: HS256, issuer: https://iam.example.com, audience: [c]}
  mode: demo
  expected_channel: c

# 身份域（ENT-01 阶段 4）：默认关闭；启用时 auth.mode 必须为 jwt。
# identity:
#   enabled: true
#   access_ttl: 15m
#   refresh_ttl: 168h
#   session:
#     idle_timeout: 72h
#     max_per_account: 10
#   revocation:
#     driver: redis              # 生产唯一实现
#     failure_mode: fail_closed  # fail_closed|fail_open
#     state_ttl: 30s             # 账号快照最大陈旧度 [1s, 60s]
#   password:
#     min_length: 12
#     max_length: 128
#     require_complexity: true
#   lockout:
#     max_failures: 5
#     window: 15m
#     duration: 15m
#   login_rate_limit:
#     rps: 1
#     burst: 5
#   sms:
#     enabled: true
#     driver: memory             # memory(本地) | aliyun(生产)
#     template_id: auth_login_code
#     sign_name: ""
#     locale: zh-CN
#     code_ttl: 5m
#     max_attempts: 5
#     resend_interval: 60s
#     daily_per_phone: 10
#     hourly_per_ip: 30
#   oauth:
#     auto_provision: false
#     providers:
#       - name: example
#         client_id: ""
#         client_secret_env: EXAMPLE_OAUTH_CLIENT_SECRET
#         auth_url: https://idp.example.com/oauth2/authorize
#         token_url: https://idp.example.com/oauth2/token
#         userinfo_url: https://idp.example.com/oauth2/userinfo
#         redirect_uri: https://c.example.com/c/v1/auth/oauth/example/callback
#         scopes: [openid, profile]
#         subject_field: sub
# 说明：identity.sms.driver=aliyun 时，凭证只从环境变量
# ALIYUN_SMS_ACCESS_KEY_ID / ALIYUN_SMS_ACCESS_KEY_SECRET 读取。

# 雪花 ID 节点号：同一集群内必须唯一，重复会生成相同 ID（ENT-02）。
id:
  node_id: 0                     # [0,1023]；prod/staging 非 worker 必须显式配置
  node_id_source: env            # env|config|statefulset；statefulset 由 HOSTNAME 末位序号推导

# 写请求幂等：仅对写方法生效（ENT-02）。
idempotency:
  enabled: false                 # 默认关闭；prod/staging 启用必须 driver=redis
  driver: memory                 # memory|redis
  header: Idempotency-Key
  ttl: 24h
  required: false                # true 时写请求缺少幂等键直接拒绝
  max_body_bytes: 1048576        # 参与指纹/缓存的请求体上限（1 MiB）

# 请求限流：按端开启（REL-05 / ENT-02）。
rate_limit:
  enabled: false
  driver: memory                 # memory|redis；prod/staging 启用必须 redis
  key: channel                   # channel|channel_user|channel_tenant_user|client
  failure_mode: fail_open        # Redis 故障时 fail_open|fail_closed
  rps: 100
  burst: 200
  idle_ttl: 10m

# 异步基础设施：事务性 Outbox + 消费运行时（ENT-03）。
async:
  enabled: false                 # 默认关闭；启用要求 db.driver 非 memory
  driver: db                     # db|nats；nats 时下方 broker 必填
  broker:                        # 仅 driver=nats 生效（NATS JetStream）
    url: ""                      # nats://|tls://|ws://|wss://；prod/staging 必须 tls|wss
    stream: async                # JetStream 流名，[A-Za-z0-9_-]
    subject_prefix: async        # 主题前缀，最终 subject=<prefix>.<topic>
    ack_wait: 30s                # 确认超时，[1s, 30m]
    max_deliver: 10              # 最大投递次数，超限进 <prefix>.dlq.<topic>，[1, 100]
  outbox:
    publish_in_api: false        # prod/staging + iam.mode=enforce 必须 false（由 worker 独占投递）
    poll_interval: 1s
    batch_size: 100
    lease: 30s
    max_attempts: 10
    concurrency: 2
  consumer:
    concurrency: 4
    visibility_timeout: 60s
    retry_backoff: exponential   # exponential|fixed

db:
  driver: memory
  dsn: ""

storage:
  driver: memory
  key_prefix: "local/c/"
  local:
    root: ""
  s3:
    endpoint: ""
    region: ""
    bucket: ""
    force_path_style: false

tracing:
  enabled: true
  exporter: none
  endpoint: ""
  insecure: false
