# 复制为 configs/c.yaml 后按需修改；勿提交含真实密钥的 yaml（CONFIG_STANDARDS）。
env: local
service: c-api
channel: c
addr: ":8083"
shutdown_timeout: 15s

log:
  level: info
  format: json

auth:
  # 演示用：Authorization: Bearer c.<user_id>
  demo_mode: true
  expected_channel: c

db:
  driver: memory
  dsn: ""

storage:
  driver: memory
  key_prefix: "local/c/"
  local:
    root: ""
  s3:
    endpoint: ""
    region: ""
    bucket: ""
    force_path_style: false

tracing:
  enabled: true
  exporter: none
  endpoint: ""
  insecure: false
