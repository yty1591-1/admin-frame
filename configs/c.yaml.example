# 复制为 configs/c.yaml 后按需修改；勿提交含真实密钥的 yaml（CONFIG_STANDARDS）。
env: local
service: c-api
channel: c
addr: ":8083"
shutdown_timeout: 15s

http:
  read_header_timeout: 5s
  read_timeout: 15s
  write_timeout: 30s
  idle_timeout: 60s
  timeout: 30s
  body_limit_bytes: 33554432

log:
  level: info
  format: json

auth:
  # demo：本地/测试专用；prod/staging 必须改为 jwt。
  #   mode: jwt
  #   jwt: {alg: HS256, issuer: https://iam.example.com, audience: [c]}
  mode: demo
  expected_channel: c

db:
  driver: memory
  dsn: ""

storage:
  driver: memory
  key_prefix: "local/c/"
  local:
    root: ""
  s3:
    endpoint: ""
    region: ""
    bucket: ""
    force_path_style: false

tracing:
  enabled: true
  exporter: none
  endpoint: ""
  insecure: false
