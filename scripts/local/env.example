# 本地开发环境变量样例（复制为 scripts/local/.env，该文件已 gitignore）。
# 仅放行：ADMIN_FRAME_DB_* / ADMIN_FRAME_REDIS_*、CONFIG_* / CONFIGCENTER_*、
# 以及通知装配期盐（非业务配置覆盖）。禁止写入 JWT / 业务密钥明文。
#
# 依赖默认对齐 docker-compose.integration.yml（MySQL root/root，库 admin_frame_test）。

ADMIN_FRAME_DB_DRIVER=mysql
ADMIN_FRAME_DB_DSN=root:root@tcp(127.0.0.1:3306)/admin_frame_test?parseTime=true&loc=UTC&charset=utf8mb4
ADMIN_FRAME_REDIS_ADDR=127.0.0.1:6379

CONFIG_API_URL=http://127.0.0.1:8085
CONFIGCENTER_ENV=dev
CONFIGCENTER_CACHE_DIR=var/configcenter-cache

# 安装向导凭据（所有环境统一走安装流程：begin → apply → complete）。
# 本地固定值，仅用于 scripts/local/dev-services.sh 自动安装，勿用于任何真实环境。
CONFIG_INSTALL_SETUP_TOKEN=local-dev-install-setup-token-0123456789abcdef

# 本地 KEK（prod 禁止）；固定值便于反复启动，勿用于真实环境。
CONFIGCENTER_KEK_DRIVER=local
CONFIGCENTER_LOCAL_KEK_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# worker / 通知装配期必填（≥32 字节）；本地固定值，非生产密钥。
ADMIN_FRAME_NOTIFICATION_BLACKLIST_SALT=smoke-local-blacklist-salt-32b!!
