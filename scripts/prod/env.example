# 本机 prod 演练：最小启动环境变量（复制为 scripts/prod/.env，已 gitignore）。
#
# 范围（ADR-0017）：仅 config-api / 业务进程自举与 mTLS / Vault KEK。
# 业务配置（db.driver、storage.driver、JWT 等）由 Admin「/setup/install」手动播种，
# 禁止在本文件写入业务 JWT 明文或第三方真实凭据。
#
# 依赖：docker compose -f docker-compose.prod-rehearsal.yml up -d
# 证书：bash scripts/prod/gen-mtls-certs.sh
# Vault：bash scripts/prod/vault-init.sh

# ---- 基础设施（各进程自举，不进配置中心 Item）----
ADMIN_FRAME_DB_DRIVER=mysql
# DSN 必须加引号：否则 bash source / make prod-migrate 会因 tcp(...) 与 & 语法失败。
ADMIN_FRAME_DB_DSN="root:root@tcp(127.0.0.1:3306)/admin_frame_prod?parseTime=true&loc=UTC&charset=utf8mb4"
ADMIN_FRAME_REDIS_ADDR=127.0.0.1:6379

# ---- 配置中心最小启动 ----
CONFIGCENTER_ENV=prod
CONFIGCENTER_CACHE_DIR=var/configcenter-cache-prod
CONFIGCENTER_KEK_DRIVER=vault
CONFIGCENTER_VAULT_TRANSIT_KEY=configcenter
# 安装写路径必填（Admin /setup/install）；演练固定值，非生产密钥。
CONFIG_INSTALL_SETUP_TOKEN=prod-rehearsal-install-setup-token-32b
VAULT_ADDR=http://127.0.0.1:8200
# 占位；file 存储 Vault 的真实 root token 由 vault-init 写入 var/prod-vault/root.token，
# prod-services 启动时会自动覆盖本值（仅注入 config-api）。
VAULT_TOKEN=replace-after-vault-init

CONFIG_API_URL=https://127.0.0.1:8085
CONFIG_API_ADDR=:8085
CONFIG_API_MTLS=require
CONFIG_API_TLS_CERT=var/prod-mtls/server.crt
CONFIG_API_TLS_KEY=var/prod-mtls/server.key
CONFIG_API_TLS_CLIENT_CA=var/prod-mtls/ca.crt
CONFIG_API_TLS_CA=var/prod-mtls/ca.crt
# 默认指向 config-api 客户端证书；各进程启动时脚本会覆盖为 client-<role>.*。
CONFIG_API_CLIENT_CERT=var/prod-mtls/client-config-api.crt
CONFIG_API_CLIENT_KEY=var/prod-mtls/client-config-api.key
CONFIG_API_NAMESPACE_ALLOWLIST=*:platform,identity,iam,audit,tenant,notification,featureflag,config
# 安装期密钥 grant 白名单（CC-R-05）；须与客户端证书 CN / CONFIG_SERVICE_IDENTITY 一致。
CONFIG_BOOTSTRAP_GRANT_IDENTITY=config-api,admin-api,biz-api,c-api,worker

# 默认 node_id；prod-services 会按进程覆盖为唯一值。
ADMIN_FRAME_ID_NODE_ID=1

# ---- 部署侧对象存储 overlay（prod-like 播种固定 storage.driver=s3）----
# 说明：prod/staging 的播种叠加把 storage.driver 定为 s3（见
# internal/configcenter/app/prod_defaults.go），而 bucket/region 等连接参数属
# 「永久排除、不进配置中心」的部署侧注入项（docs/CONFIG_STANDARDS.md §3.1.1）。
# 因此本文件必须提供这组变量，否则业务进程与 admin-api 都会在 Validate 阶段
# 报 "s3 requires bucket and region" 退出，Admin 安装向导也就打不开。
# 以下取值与 docker-compose.prod-rehearsal.yml 的 RustFS 一致，仅演练用。
ADMIN_FRAME_STORAGE_S3_ENDPOINT=http://127.0.0.1:19000
ADMIN_FRAME_STORAGE_S3_BUCKET=admin-frame
ADMIN_FRAME_STORAGE_S3_REGION=us-east-1
ADMIN_FRAME_STORAGE_S3_ACCESS_KEY=rustfsadmin
ADMIN_FRAME_STORAGE_S3_SECRET_KEY=rustfsadmin
ADMIN_FRAME_STORAGE_S3_FORCE_PATH_STYLE=true
#
# worker 通知装配期盐（若未走配置中心密钥托管时的本地回退，≥32 字节）：
# ADMIN_FRAME_NOTIFICATION_BLACKLIST_SALT=smoke-prod-rehearsal-blacklist-salt32
