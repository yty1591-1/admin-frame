{
  "name": "admin-frame-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev:admin": "pnpm -F @admin-frame/admin-web dev",
    "dev:biz": "pnpm -F @admin-frame/biz-web dev",
    "gen:api": "node scripts/gen-api.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:i18n": "node scripts/check-i18n.mjs",
    "typecheck": "pnpm -r --parallel typecheck",
    "boundaries": "depcruise apps packages --config dependency-cruiser.cjs --output-type err",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "build": "pnpm -F @admin-frame/admin-web build && pnpm -F @admin-frame/biz-web build",
    "size": "node scripts/check-size.mjs",
    "license": "node scripts/check-licenses.mjs",
    "audit": "pnpm audit --audit-level=high",
    "e2e": "playwright test",
    "ci": "pnpm format:check && pnpm lint && pnpm lint:i18n && pnpm boundaries && pnpm typecheck && pnpm test:ci && pnpm build && pnpm size && pnpm license"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "openapi-typescript": "7.4.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
