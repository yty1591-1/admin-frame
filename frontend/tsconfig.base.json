{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@admin-frame/shared": ["packages/shared/src/index.ts"],
      "@admin-frame/api-client": ["packages/api-client/src/index.ts"],
      "@admin-frame/auth": ["packages/auth/src/index.ts"],
      "@admin-frame/ui": ["packages/ui/src/index.ts"],
      "@admin-frame/testing": ["packages/testing/src/index.ts"]
    }
  }
}
