# 前端构建期环境变量模板（FE-B-05）
#
# 用法：复制到目标应用目录后按需修改，例如
#   cp .env.example apps/web-admin/.env
#   cp .env.example apps/web-biz/.env
#
# 约束：
# - 这里只放非敏感配置；密钥、口令一律不进前端（见 FRONTEND_STANDARDS FE-SEC-04）。
# - 变量必须在 internal/vite-config/src/utils/env.ts 的 DECLARED_ENV_KEYS 中登记，
#   否则构建会直接失败。
# - 不要把本文件改成 `.env` 后提交；各应用的 `.env` 已被 .gitignore 忽略。
#
# 两个应用共用的可选开关（写入应用目录下的 .env 或 .env.<mode>）：
# VITE_APP_TITLE="ADMIN FRAME 管理端"
# VITE_APP_NAMESPACE="vben-web-admin"
# VITE_BASE="/"
# VITE_GLOB_API_URL="/admin/v1"
# VITE_COMPRESS="none"          # none | gzip | brotli
# VITE_PWA="false"
# VITE_DEVTOOLS="false"
# VITE_VISUALIZER="false"
# VITE_ARCHIVER="true"
# VITE_INJECT_APP_LOADING="true"
# VITE_PORT="5173"

# SecureLS 的“混淆密钥”：不是安全边界，仅防止同源脚本随手读明文。
# 生产可覆盖；不得设置为真实凭据。
VITE_APP_STORE_SECURE_KEY="change-me-at-deploy"

# 由 viteMetadataPlugin 自动注入，无需在此维护：
# VITE_APP_VERSION / VITE_APP_GIT_SHA / VITE_APP_BUILD_TIME
