{
  "uid": "af-identity",
  "title": "Admin Frame / Identity",
  "tags": ["admin-frame", "identity"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "登录结果（success/failure/challenge）",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result, reason) (rate(identity_login_total[5m]))",
          "legendFormat": "{{result}} / {{reason}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "登录耗时 P95 / P99",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 0, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(identity_login_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(identity_login_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(identity_login_tx_duration_seconds_bucket[5m])))",
          "legendFormat": "tx p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "账号锁定与刷新结果",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(identity_lockout_total[5m]))",
          "legendFormat": "lockout"
        },
        {
          "refId": "B",
          "expr": "sum by (result) (rate(identity_refresh_total[5m]))",
          "legendFormat": "refresh {{result}}"
        },
        {
          "refId": "C",
          "expr": "sum(rate(identity_token_reuse_total[5m]))",
          "legendFormat": "token reuse"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "MFA 校验与恢复码使用",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(identity_mfa_verify_total[5m]))",
          "legendFormat": "mfa verify {{result}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(identity_mfa_recovery_used_total[5m]))",
          "legendFormat": "recovery used"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "撤销存储 / 快照写入失败",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (op) (rate(identity_revocation_store_errors_total[5m]))",
          "legendFormat": "store {{op}}"
        },
        {
          "refId": "B",
          "expr": "sum by (op) (rate(identity_revocation_cache_write_error_total[5m]))",
          "legendFormat": "cache {{op}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "设备会话撤销（按原因 / 结果）",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason, result) (rate(identity_session_revoke_total[5m]))",
          "legendFormat": "{{reason}} / {{result}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "短信发送与 OAuth 回调",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(identity_sms_send_total[5m]))",
          "legendFormat": "sms {{result}}"
        },
        {
          "refId": "B",
          "expr": "sum by (provider, result) (rate(identity_oauth_callback_total[5m]))",
          "legendFormat": "oauth {{provider}} / {{result}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "短信供应商告警",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind, provider) (increase(identity_sms_provider_alerts_total[5m]))",
          "legendFormat": "{{kind}} / {{provider}}"
        }
      ]
    }
  ]
}
